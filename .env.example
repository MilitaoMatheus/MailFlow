# Ambiente da Aplicação
APP_ENV=development
APP_NAME="Newsletter & Email Manager"
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# Chaves de Segurança
# Gere uma chave aleatória de 32 bytes em base64 para ENCRYPTION_KEY
# Exemplo gerador Python: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMmJ5dGUtZmVybmV0LWtleT0=

# Banco de Dados
# SQLite local padrão: sqlite:///./newsletter.db
# Para MySQL: mysql+pymysql://usuario:senha@localhost:3306/newsletter_db
# Para PostgreSQL: postgresql://usuario:senha@localhost:5432/newsletter_db
DATABASE_URL=sqlite:///./newsletter.db

# Configurações de Envio Padrão
DEFAULT_RATE_LIMIT_PER_SECOND=5
EMAIL_PROVIDER_DEFAULT=smtp
MOCK_EMAIL_SENDING=False

# URL Base para links de descadastro público
APP_BASE_URL=http://localhost:8000
